{
  "expo": {
    "name": "EcoTrust",
    "slug": "app-financas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appfinancas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "EcoTrust",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "EcoTrust uses Face ID so you can sign in to the app securely."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "EcoTrust uses the camera to read the QR code on your receipts and invoices and fill in the purchase and its taxes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "pt-PT",
            "es",
            "fr",
            "de",
            "it",
            "nl",
            "pl"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5f01efb-36d6-4c18-971c-9291d4e89b93"
      }
    },
    "locales": {
      "en": "./locales/en.json",
      "pt-PT": "./locales/pt-PT.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json",
      "nl": "./locales/nl.json",
      "pl": "./locales/pl.json"
    }
  }
}
